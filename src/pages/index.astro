---
import '../styles/global.css';

const bot = {
  name: 'Shiroko MD',
  owner: 'Skyline',
  number: '085185757240',
  numberIntl: '6285185757240',
  image: 'https://u.pone.rs/dtnqjlqd.jpg',
};

const owner = {
  name: 'Skyline',
  number: '085134116039',
  numberIntl: '6285134116039',
  image: 'https://u.pone.rs/lhshmmdb.jpg',
};

const links = {
  group: 'https://chat.whatsapp.com/H0KavcclDoi07D6jVtn83F',
  channel: 'https://whatsapp.com/channel/0029VbDi830Eawdl50lDVv24',
  owner: `https://wa.me/${owner.numberIntl}`,
  bot: `https://wa.me/${bot.numberIntl}`,
};

const skills = [
  { name: 'JavaScript', note: 'Bot logic & automation' },
  { name: 'HTML', note: 'Structure & semantic UI' },
  { name: 'CSS', note: 'Responsive visual system' },
  { name: 'Astro', note: 'Fast modern web stack' },
];

const ticker = ['JavaScript', 'HTML', 'CSS', 'Astro', 'WhatsApp', 'Automation'];
const tickerGroup = [...ticker, ...ticker, ...ticker];

const externalImageFallback = "this.style.opacity='0'; this.nextElementSibling?.removeAttribute('hidden')";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070913" />
    <meta name="description" content="Portofolio resmi Shiroko MD — WhatsApp bot milik Skyline." />
    <meta property="og:title" content="Shiroko MD — WhatsApp Bot Portfolio" />
    <meta property="og:description" content="Portofolio resmi Shiroko MD — WhatsApp bot milik Skyline." />
    <meta property="og:image" content={bot.image} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://u.pone.rs" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>Shiroko MD — WhatsApp Bot Portfolio</title>
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <span class="blob blob-a"></span>
      <span class="blob blob-b"></span>
      <span class="blob blob-c"></span>
    </div>
    <div class="progress" id="progress" aria-hidden="true"></div>

    <header class="topbar">
      <div class="container nav">
        <a class="brand" href="#top" aria-label="Shiroko MD home">
          <span class="brand-mark" aria-hidden="true">✦</span>
          <span>
            <small>WhatsApp Bot</small>
            <strong>Shiroko MD</strong>
          </span>
        </a>

        <nav class="nav-links" id="nav-links" aria-label="Navigasi utama">
          <a href="#about">Tentang</a>
          <a href="#skills">Skill</a>
          <a href="#community">Komunitas</a>
        </nav>

        <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Buka menu">
          ☰
        </button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <span class="eyebrow fx" style="--i:0"><span class="status-dot"></span> Automation • WhatsApp • Astro</span>
            <h1>
              <span class="line"><span class="word" style="--i:0">Meet</span></span>
              <span class="line"><span class="word gradient-text" style="--i:1">Shiroko MD.</span></span>
            </h1>
            <p class="rotator fx" style="--i:2" aria-live="off">
              <span class="rotator-label">Dibuat untuk</span>
              <span class="rotator-word" id="rotator">otomasi</span>
            </p>
            <p class="hero-copy fx" style="--i:3">
              Bot WhatsApp yang dirancang untuk membantu otomasi, utilitas, dan interaksi komunitas — dibangun oleh <strong>Skyline</strong> dengan stack web modern.
            </p>
            <div class="hero-actions fx" style="--i:4">
              <a class="btn btn-primary" href={links.bot} target="_blank" rel="noreferrer">
                Chat Bot
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a class="btn btn-ghost" href="#skills">Lihat Skill</a>
            </div>
          </div>

          <div class="hero-card-wrap fx" style="--i:2">
            <span class="orb orb-a" aria-hidden="true"></span>
            <span class="orb orb-b" aria-hidden="true"></span>
            <span class="float-chip c1" aria-hidden="true"><i></i>JavaScript</span>
            <span class="float-chip c2" aria-hidden="true"><i></i>Astro</span>
            <span class="float-chip c3" aria-hidden="true"><i></i>WhatsApp</span>
            <div class="hero-card spot" data-tilt>
              <div class="bot-visual">
                <img class="fade" src={bot.image} alt="Thumbnail Shiroko MD" width="640" height="720" fetchpriority="high" decoding="async" onerror={externalImageFallback} />
                <div hidden class="bot-overlay bot-fallback">Image unavailable</div>
                <div class="bot-overlay">
                  <div class="bot-overlay-row">
                    <div>
                      <div class="bot-name">{bot.name}</div>
                      <div class="bot-tag">Owner: {bot.owner}</div>
                    </div>
                    <span class="chip">READY</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          <div class="marquee-group">{tickerGroup.map((t) => <span>{t}</span>)}</div>
          <div class="marquee-group">{tickerGroup.map((t) => <span>{t}</span>)}</div>
        </div>
      </div>

      <section class="section reveal-section" id="about">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="section-kicker">01 / Identity</div>
              <h2 class="section-title">Satu bot. Satu identitas.</h2>
            </div>
            <p class="section-copy">Profil singkat bot dan owner, dibuat ringkas supaya informasi penting tetap mudah ditemukan.</p>
          </div>

          <div class="grid-2">
            <article class="card card-inner spot reveal stagger-1">
              <div class="bot-profile">
                <div class="avatar">
                  <img class="fade" src={bot.image} alt="Avatar Shiroko MD" width="78" height="78" loading="lazy" decoding="async" onerror={externalImageFallback} />
                </div>
                <div>
                  <div class="profile-label">Bot profile</div>
                  <div class="profile-value">{bot.name}</div>
                  <div class="profile-sub">Managed by {bot.owner}</div>
                </div>
              </div>
              <div class="meta-list">
                <div class="meta-row"><span>Nomor bot</span><strong><button class="copy-btn" data-copy={bot.number}>{bot.number}</button></strong></div>
                <div class="meta-row"><span>Platform</span><strong>WhatsApp</strong></div>
                <div class="meta-row"><span>Core</span><strong>Automation</strong></div>
              </div>
            </article>

            <article class="card card-inner spot reveal stagger-2">
              <div class="owner-card">
                <div class="owner-avatar">
                  <img class="fade" src={owner.image} alt="Profile owner Skyline" width="78" height="78" loading="lazy" decoding="async" onerror={externalImageFallback} />
                </div>
                <div>
                  <div class="profile-label">Owner</div>
                  <div class="profile-value">{owner.name}</div>
                  <div class="profile-sub">Developer & maintainer</div>
                </div>
              </div>
              <div class="meta-list">
                <div class="meta-row"><span>Nomor owner</span><strong><button class="copy-btn" data-copy={owner.number}>{owner.number}</button></strong></div>
                <div class="meta-row"><span>Role</span><strong>Bot Developer</strong></div>
                <div class="meta-row"><span>Profile</span><strong><a href={links.owner} target="_blank" rel="noreferrer">WhatsApp →</a></strong></div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="section reveal-section" id="skills">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="section-kicker">02 / Stack</div>
              <h2 class="section-title">Teknologi di balik Shiroko.</h2>
            </div>
            <p class="section-copy">Empat teknologi utama yang digunakan untuk membangun dan mengembangkan ekosistem Shiroko MD.</p>
          </div>

          <div class="skill-grid">
            {skills.map((skill, index) => (
              <article class="skill spot reveal" style={`--delay:${index * 80}ms`} data-index={`0${index + 1}`}>
                <span class="skill-glyph" aria-hidden="true">{skill.name.slice(0, 2)}</span>
                <div class="skill-number">Skill 0{index + 1}</div>
                <div class="skill-title">{skill.name}</div>
                <div class="skill-note">{skill.note}</div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section reveal-section" id="community">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="section-kicker">03 / Connect</div>
              <h2 class="section-title">Tetap terhubung dengan Shiroko.</h2>
            </div>
            <p class="section-copy">Pilih kanal yang paling nyaman untuk mengikuti update atau menghubungi Skyline.</p>
          </div>

          <div class="links-grid">
            <a class="card link-card spot reveal" href={links.group} target="_blank" rel="noreferrer">
              <span class="link-icon" aria-hidden="true">◈</span>
              <span><h3>WhatsApp Group</h3><p>Gabung komunitas</p></span>
              <span class="link-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="card link-card spot reveal" href={links.channel} target="_blank" rel="noreferrer">
              <span class="link-icon" aria-hidden="true">◉</span>
              <span><h3>WhatsApp Channel</h3><p>Update & informasi</p></span>
              <span class="link-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="card link-card spot reveal" href={links.owner} target="_blank" rel="noreferrer">
              <span class="link-icon" aria-hidden="true">✦</span>
              <span><h3>Contact Owner</h3><p>Chat dengan Skyline</p></span>
              <span class="link-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>

      <section class="section reveal-section" aria-label="Ajakan">
        <div class="container">
          <div class="cta reveal">
            <div>
              <h3>Talk to Shiroko.</h3>
              <p>Mulai percakapan langsung lewat WhatsApp dan kenali Shiroko MD lebih dekat.</p>
            </div>
            <a class="btn btn-primary" href={links.bot} target="_blank" rel="noreferrer">Open WhatsApp →</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-row">
        <span>© {new Date().getFullYear()} Shiroko MD · Skyline</span>
        <span>Built with Astro</span>
      </div>
    </footer>

    <script>
      const doc = document.documentElement;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      /* ---- Menu mobile ---- */
      const menu = document.querySelector('#menu-btn');
      const nav = document.querySelector('#nav-links');
      menu?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open') ?? false;
        menu.setAttribute('aria-expanded', String(open));
      });
      nav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          nav.classList.remove('is-open');
          menu?.setAttribute('aria-expanded', 'false');
        });
      });

      /* ---- Scroll: progress bar + state topbar (1 handler, throttled rAF) ---- */
      const bar = document.querySelector('#progress');
      const topbar = document.querySelector('.topbar');
      let maxScroll = 1;
      let ticking = false;
      const measure = () => { maxScroll = Math.max(1, doc.scrollHeight - window.innerHeight); };
      const paintScroll = () => {
        const y = window.scrollY;
        if (bar) bar.style.transform = `scaleX(${Math.min(1, y / maxScroll)})`;
        topbar?.classList.toggle('is-scrolled', y > 8);
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(paintScroll);
      }, { passive: true });
      window.addEventListener('resize', () => { measure(); paintScroll(); }, { passive: true });
      window.addEventListener('load', measure);
      measure(); paintScroll();

      /* ---- Reveal saat scroll ---- */
      const revealItems = document.querySelectorAll('.reveal');
      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealItems.forEach((el) => el.classList.add('is-visible', 'done'));
      } else {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            el.classList.add('is-visible');
            // setelah animasi masuk selesai, kembalikan transition hover yang cepat
            window.setTimeout(() => el.classList.add('done'), 1100);
            observer.unobserve(el);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        revealItems.forEach((el) => revealObserver.observe(el));
      }

      /* ---- Nav aktif sesuai section ---- */
      const navLinks = [...document.querySelectorAll('.nav-links a')];
      if ('IntersectionObserver' in window) {
        const spy = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            navLinks.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === `#${entry.target.id}`)));
          });
        }, { rootMargin: '-45% 0px -50% 0px' });
        document.querySelectorAll('section[id]').forEach((sec) => spy.observe(sec));
      }

      /* ---- Fade-in gambar setelah ter-load ---- */
      document.querySelectorAll('img.fade').forEach((img) => {
        if (img.complete && img.naturalWidth) img.classList.add('is-loaded');
        else img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
      });

      /* ---- Spotlight kursor (delegasi event, throttled rAF, hanya mouse) ---- */
      if (finePointer && !reduceMotion) {
        let frame = 0;
        let last = null;
        document.addEventListener('pointermove', (event) => {
          const el = event.target instanceof Element ? event.target.closest('.spot') : null;
          if (!el) return;
          last = { el, x: event.clientX, y: event.clientY };
          if (frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            if (!last) return;
            const rect = last.el.getBoundingClientRect();
            last.el.style.setProperty('--sx', `${last.x - rect.left}px`);
            last.el.style.setProperty('--sy', `${last.y - rect.top}px`);
          });
        }, { passive: true });
      }

      /* ---- Tilt halus (lerp di rAF; loop berhenti sendiri saat diam) ---- */
      const tilt = document.querySelector('[data-tilt]');
      if (tilt && finePointer && !reduceMotion) {
        let tx = 0, ty = 0, cx = 0, cy = 0, running = false;
        const step = () => {
          cx += (tx - cx) * 0.1;
          cy += (ty - cy) * 0.1;
          tilt.style.transform = `perspective(1100px) rotateX(${cy.toFixed(2)}deg) rotateY(${cx.toFixed(2)}deg)`;
          if (Math.abs(tx - cx) > 0.01 || Math.abs(ty - cy) > 0.01) requestAnimationFrame(step);
          else { running = false; if (tx === 0 && ty === 0) tilt.style.transform = ''; }
        };
        const kick = () => { if (!running) { running = true; requestAnimationFrame(step); } };
        tilt.addEventListener('pointermove', (event) => {
          const rect = tilt.getBoundingClientRect();
          tx = ((event.clientX - rect.left) / rect.width - 0.5) * 7;
          ty = ((event.clientY - rect.top) / rect.height - 0.5) * -5;
          kick();
        }, { passive: true });
        tilt.addEventListener('pointerleave', () => { tx = 0; ty = 0; kick(); });
      }

      /* ---- Kata berganti di hero ---- */
      const rotator = document.querySelector('#rotator');
      if (rotator && !reduceMotion) {
        const words = ['otomasi', 'utilitas', 'komunitas', 'interaksi'];
        let i = 0;
        window.setInterval(() => {
          if (document.hidden) return;
          rotator.classList.add('is-out');
          window.setTimeout(() => {
            i = (i + 1) % words.length;
            rotator.textContent = words[i];
            rotator.classList.remove('is-out');
          }, 350);
        }, 2600);
      }

      /* ---- Copy nomor ---- */
      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.getAttribute('data-copy');
          if (!value) return;
          try {
            await navigator.clipboard.writeText(value);
            const original = button.textContent;
            button.textContent = 'Copied ✓';
            window.setTimeout(() => { button.textContent = original; }, 1200);
          } catch {
            button.textContent = value;
          }
        });
      });
    </script>
  </body>
</html>
